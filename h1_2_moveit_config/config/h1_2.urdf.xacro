<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="h1_2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <xacro:include filename="$(find h1_2_description)/urdf/h1_2.urdf" />

    <link name="L_palm_tcp"/>
    <joint name="L_hand_base_to_palm_tcp" type="fixed">
        <parent link="L_hand_base_link"/>
        <child link="L_palm_tcp"/>
        <origin xyz="-0.010 -0.12 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="R_palm_tcp"/>
    <joint name="R_hand_base_to_palm_tcp" type="fixed">
        <parent link="R_hand_base_link"/>
        <child link="R_palm_tcp"/>
        <origin xyz="-0.010 -0.12 0.0" rpy="0.0 0.0 0.0"/>
    </joint>
    <xacro:include filename="h1_2.ros2_control.xacro" />

    <xacro:h1_2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>